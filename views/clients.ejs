<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="css/style.css" />
  </head>
  <body>
    <h1>CASAS DASHBOARD</h1>
     <h2><%= user.userName%> has <%= left%> clients</h2>

  <%# ------- TODAY'S ROUTE ------%>
  <div>
    <% if (!validDays.includes(today)) { %>
      <p>No clients scheduled today — enjoy your day off!</p>
    <% } else if (todayRoute.error) { %>
      <h3>Today's Route (<%= today %>)</h3>
      <p>Error: <%= todayRoute.error %></p>
    <% } else { %>
      <h3>Today's Route (<%= today %>)</h3>
      <h4><%= today %> — <%= todayRoute.miles %> mi, <%= todayRoute.minutes %> min driving</h4>
      <table>
        <thead><tr><th>#</th><th>Client</th><th>Arrive</th><th>Depart</th></tr></thead>
        <tbody>
        <% todayRoute.schedule.forEach((s, i) => { %>
          <tr><td><%= i + 1 %></td><td><%= s.name %></td><td><%= s.arrive %></td><td><%= s.depart %></td></tr>
        <% }) %>
        </tbody>
      </table>
      <p><a href="<%= todayRoute.deepLink %>" target="_blank">Open in Google Maps</a></p>
    <% } %>
  </div>

    <ul>
    <% clients.forEach( el => { %>
            <li class='clientName' data-id='<%=el._id%>'>
                <span class='<%= el.completed === true ? 'completed' : 'not'%>'><%= el.name %></span>
                <span><%= el.address %></span>
                <span><%= el.phone %></span>
                <span class="day-tag <%= el.day %>"><%= el.day %></span>
                <a href="/clients/edit/<%= el._id %>">Edit</a>
                <span class="deleteClient">Delete</span>
            </li>
    <% }) %>    
    </ul>

  <%# ------- WEEKLY CLIENT LIST ------%>
<div>
    <h3>Monday Clients: </h3>
    <ul>
      <% mondayClients.forEach( el => { %>
            <li  data-id='<%=el._id%>'>
                <span><%= el.name %></span>
                <span><%= el.address %></span>
                <span><%= el.phone %></span>
            </li>
    <% }) %>    
    </ul>

    <h3>Tuesday Clients: </h3>
    <ul>
      <% tuesdayClients.forEach( el => { %>
            <li  data-id='<%=el._id%>'>
                <span><%= el.name %></span>
                <span><%= el.address %></span>
                <span><%= el.phone %></span>
            </li>
    <% }) %>    
    </ul>

    <h3>Wednesday Clients: </h3>
    <ul>
      <% wednesdayClients.forEach( el => { %>
            <li  data-id='<%=el._id%>'>
                <span><%= el.name %></span>
                <span><%= el.address %></span>
                <span><%= el.phone %></span>
            </li>
    <% }) %>    
    </ul>

    <h3>Thursday Clients: </h3>
    <ul>
      <% thursdayClients.forEach( el => { %>
            <li  data-id='<%=el._id%>'>
                <span><%= el.name %></span>
                <span><%= el.address %></span>
                <span><%= el.phone %></span>
            </li>
    <% }) %>    
    </ul>

    <h3>Friday Clients: </h3>
    <ul>
      <% fridayClients.forEach( el => { %>
            <li  data-id='<%=el._id%>'>
                <span><%= el.name %></span>
                <span><%= el.address %></span>
                <span><%= el.phone %></span>
            </li>
    <% }) %>    
    </ul>

    <h3>Saturday Clients: </h3>
    <ul>
      <% saturdayClients.forEach( el => { %>
            <li  data-id='<%=el._id%>'>
                <span><%= el.name %></span>
                <span><%= el.address %></span>
                <span><%= el.phone %></span>
            </li>
    <% }) %>    
    </ul>
   </div>

    <form action="/clients/createClient" method="POST">
      <input type="text" placeholder="Name" name="clientName">
      <input type="text" placeholder="Phone" name="clientPhone">
      <input type="text" placeholder="Address" name="clientAddress">
      <select name="clientDay">
        <option value="Monday">Monday</option>
        <option value="Tuesday">Tuesday</option>
        <option value="Wednesday">Wednesday</option>
        <option value="Thursday">Thursday</option>
        <option value="Friday">Friday</option>
        <option value="Saturday">Saturday</option>
      </select>
      <input type="submit">
    </form>

    <a href="/logout">Logout</a>

  <%# ------- ROUTE OPTIMIZER ------%>
  <div>
    <h3>Get Optimized Route</h3>
    <div id="day-route-buttons">
      <button class="route-btn" data-day="Monday">Mon</button>
      <button class="route-btn" data-day="Tuesday">Tue</button>
      <button class="route-btn" data-day="Wednesday">Wed</button>
      <button class="route-btn" data-day="Thursday">Thu</button>
      <button class="route-btn" data-day="Friday">Fri</button>
      <button class="route-btn" data-day="Saturday">Sat</button>
    </div>
    <div id="route-result"></div>
  </div>

    <script src="js/main.js"></script>
  </body>
</html>
