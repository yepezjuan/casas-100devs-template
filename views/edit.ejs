<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <h1>EDIT CLIENT</h1>

    <div class="editClient" data-id="<%= client._id %>">
      <input type="text" placeholder="Name" name="clientName" value="<%= client.name %>">
      <input type="text" placeholder="Phone" name="clientPhone" value="<%= client.phone %>">
      <input type="text" placeholder="Address" name="clientAddress" value="<%= client.address %>">
      <select name="clientDay">
        <option value="Monday" <%= client.day === 'Monday' ? 'selected' : '' %>>Monday</option>
        <option value="Tuesday" <%= client.day === 'Tuesday' ? 'selected' : '' %>>Tuesday</option>
        <option value="Wednesday" <%= client.day === 'Wednesday' ? 'selected' : '' %>>Wednesday</option>
        <option value="Thursday" <%= client.day === 'Thursday' ? 'selected' : '' %>>Thursday</option>
        <option value="Friday" <%= client.day === 'Friday' ? 'selected' : '' %>>Friday</option>
        <option value="Saturday" <%= client.day === 'Saturday' ? 'selected' : '' %>>Saturday</option>
      </select>
      <button class="saveClient">Save</button>
      <a href="/clients">Cancel</a>
    </div>

    <script src="/js/main.js"></script>
  </body>
</html>
